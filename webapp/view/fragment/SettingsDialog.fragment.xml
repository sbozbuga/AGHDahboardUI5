<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog id="settingsDialog" title="Settings" contentWidth="400px" initialFocus="baseUrlInput">
		<content>
			<VBox class="sapUiSmallMargin">
				<Label text="AdGuard Home Base URL" labelFor="baseUrlInput" />
				<Input
					id="baseUrlInput"
					value="{/baseUrl}"
					showClearIcon="true"
					placeholder="e.g. http://192.168.1.50 or http://192.168.1.50/agh"
					width="100%"
					submit=".onSaveSettings"
					ariaDescribedBy="baseUrlHelpText"
				/>
				<Text
					id="baseUrlHelpText"
					text="Leave empty to use relative path (Proxy Mode)."
					class="sapUiTinyMarginBottom"
				/>

				<Label text="{i18n>customClientsTitle}" labelFor="customClientsInput" class="sapUiSmallMarginTop" />
				<TextArea
					id="customClientsInput"
					value="{/customClients}"
					placeholder="192.168.1.5 iPhone&#10;fe80::... SmartTV"
					rows="4"
					width="100%"
					growing="true"
					showExceededText="true"
					maxLength="2000"
					ariaDescribedBy="customClientsHelpText"
				/>
				<Text id="customClientsHelpText" text="{i18n>customClientsHelpText}" class="sapUiTinyMarginTop" />
			</VBox>
		</content>
		<buttons>
			<Button text="Save" press=".onSaveSettings" type="Emphasized" />
			<Button text="Cancel" press=".onCancelSettings" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>
